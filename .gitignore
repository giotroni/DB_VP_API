# Configurazione con credenziali (NON committare)
DB/config.php

# Ambiente di test locale Docker: credenziali e dump con dati reali
.env
DB/Backup/

# Documenti reali dei clienti: fatture emesse, registro incassi, ordini ricevuti.
# Servono per le verifiche (vedi docs/REGOLE-FATTURAZIONE.md) ma stanno solo
# in locale e su OneDrive, non nel repository.
docs/Fatture/
docs/Ordini/
# Fogli di analisi generati sui dati veri (confronti, prospetti)
docs/*.xlsx
docs/*.csv

# Allegati caricati dall'''interfaccia: foto delle consuntivazioni e PDF di
# offerte e ordini. Sono materiale dei clienti, come docs/Fatture e docs/Ordini,
# e stanno sul server, non qui. Il .htaccess che chiude le cartelle al web
# invece va versionato, altrimenti un rilascio le riaprirebbe.
DB/uploads/*
!DB/uploads/*/
DB/uploads/*/*
!DB/uploads/*/.htaccess

# Log
DB/logs/
API/logs/
*.log

# File temporanei / OS
Thumbs.db
.DS_Store
*.tmp
