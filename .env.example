# Template per l'ambiente di test locale Docker (vedi docs/AMBIENTE-LOCALE.md).
# Copiare in .env e scegliere le password. Il file .env NON va versionato.
#
#   cp .env.example .env

# Credenziali del MariaDB locale. Non sono le credenziali di produzione:
# valgono solo per il container, e i fallback in DB/config.php non c'entrano.
DB_ROOT_PASSWORD=root_locale
DB_NAME=vaglioty_DB_VP
DB_USER=vaglioty_DB_VP
DB_PASSWORD=locale_dev

# Cartella del dump da importare al primo avvio: DB/Backup/<BACKUP_DATE>/vaglioty_DB_VP.sql
BACKUP_DATE=20260730

# Porte sull'host (sempre legate a 127.0.0.1).
# 3306 e 8080 sono lasciate libere per XAMPP.
WEB_PORT=8081
DB_PORT=3307
PMA_PORT=8082
